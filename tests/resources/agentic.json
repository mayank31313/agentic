{
    "workspace": "/workspace",
    "mcpServers": {
        "agentic_mcp": {
            "url": "http://mcp:8811/mcp",
            "transport": "http"
        }
    },
    "models": [
        {
            "model": "openai:nvidia/nemotron-3-nano-omni-30b-a3b-reasoning",
            "model_id": "custom-nemotron-3-nano-omni-30b-a3b-reasoning",
            "base_url": "https://integrate.api.nvidia.com/v1",
            "api_key": {
                "env_key": "NVIDIA_API_KEY"
            },
            "context_window": 128000
        },
        {
            "model": "openai:gemma-4-e2b-it",
            "model_id": "custom-gemma-4-e2b-it",
            "base_url": "http://host.docker.internal:8080/v1",
            "api_key": {
                "env_key": "NVIDIA_API_KEY"
            },
            "context_window": 256000
        }
    ],
    "tools": [],
    "vector_store": {
        "backend": "in_memory",
        "enabled": true,
        "collection_name": "agentic_memory",
        "persist_directory": null,
        "es_host": "localhost",
        "es_port": 9200,
        "embedding": {
            "provider": "huggingface",
            "model": "sentence-transformers/all-MiniLM-L6-v2",
            "base_url": null,
            "api_key": null
        }
    }
}