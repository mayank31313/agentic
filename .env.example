# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Used by docker-compose.yaml. Values here are read by Docker Compose itself
# (for ${VAR} substitution), not directly by the Python app.

# --- Core secrets (always required) ---
NVIDIA_API_KEY=

# Resolved via the env secrets provider (secrets.provider.env.enable: true in
# resources/application.yml, referenced there as "env://<VAR_NAME>").
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
TAVILY_API_KEY=

AGENTIC_BOT_LOCAL_API_BASE_URL=
AGENTIC_BOT_LOCAL_API_IMAGE_MODEL=

GOOGLE_CREDENTIALS_FILE=
GITHUB_MCP_PAT_TOKEN=

